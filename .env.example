# Environment variables for Distributed Inference System
# Copy this file to .env and update with your actual values

# MQTT Configuration
MQTT_HOST=your-mqtt-broker-host
MQTT_PORT=1883
MQTT_USERNAME=your-username
MQTT_PASSWORD=your-password
TEMI_SERIAL=your-temi-serial-number

# Camera Configuration
YOLO_CAMERA_SOURCE=rtmp://your-yolo-stream:1935/live/stream
GESTURE_CAMERA_SOURCE=rtmp://your-gesture-stream:1935/live/stream

# Database Configuration
DB_HOST=your-database-host
DB_NAME=gesture
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SECRET_KEY=change-this-to-a-random-secret-key

# Target Device Configuration
TARGET_DEVICE_IP=your-target-device-ip
TARGET_DEVICE_PORT=5000

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log
